
                    @model MVC2026.Cliente
                    @{
                        ViewData["Title"] = "Cadastro de Clientes";
                    }

                    <div class="container">

                        <h1 class="text-center mt-3 fw-bold">Cadastro de Cliente</h1>
                        
                        <form action="#" method="get">
                            <div class="row">
                                <div class="col-3">
                                    <label asp-for="Email">Email</label>
                                    <input type="number" 
                                            class="form-control" 
                                            placeholder="Email do Cliente..." 
                                            asp-for="Email">
                                </div>
                                <div class="col-3">
                                    <label asp-for="Nome">Nome Completo</label>
                                    <input type="text" 
                                            class="form-control" 
                                            placeholder="Nome Completo..." 
                                            asp-for="Nome">
                                            </div>
                                            <div class="col-3">
                                    <label asp-for="CEP">CEP</label>
                                    <input type="number" 
                                            class="form-control" 
                                            placeholder="Cidade/estado/país..." 
                                            asp-for="CEP">
                                </div>
                                <div class="col-3">
                                    <label asp-for="CPF">CPF</label>
                                    <input type="number" 
                                            class="form-control" 
                                            placeholder="Cadastro de pessoa física..." 
                                            asp-for="CPF">
                                </div>
                                <div class="col-3">
                                    <label asp-for="DataNascimento">DataNascimento</label>
                                    <input type="number" 
                                            class="form-control" 
                                            placeholder="Data de nascimento do usuário..." 
                                            asp-for="DataNascimento">
                                </div>
                                <div class="col-3">
                                    <label asp-for="Celular">Celular</label>
                                    <input type="number" 
                                            class="form-control" 
                                            placeholder="Celular do usuário..." 
                                            asp-for="Celular">
                                </div>
                                <div class="col-3">
                                    <label asp-for="Bairro">Bairro</label>
                                    <input type="text" 
                                            class="form-control" 
                                            placeholder="Bairro do usuário..." 
                                            asp-for="Bairro">
                                </div>
                                <div class="col-3">
                                    <label asp-for="UF">UF</label>
                                    <input type="text" 
                                            class="form-control" 
                                            placeholder="Unidade Federativa do usuário..." 
                                            asp-for="UF">
                                </div>
                                    <div class="row mt-5">
                    <div class="col text-center">
                        <input type="reset" value="Limpar" class="w-50 btn btn-outline-secondary"/>
                    </div>
                    <div class="col text-center">
                        <input type="submit" value="Enviar" class="w-50 btn btn-primary" />
                    </div>
                </div>
                            </div>
                        </form>

                    </div>

